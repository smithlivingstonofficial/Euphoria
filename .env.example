# ==============================================================================
# EUPHORIA (KARE) - ENVIRONMENT CONFIGURATION
# ==============================================================================

# 1. Supabase Project Credentials (from your Supabase Dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key-here

# 2. Cryptographic QR Pass Signing Secret
# (Generate a random 32+ character string for production)
QR_SIGNING_SECRET=euphoria-kare-qr-signing-secret-2026-super-secure-token

# 3. Modular Payment Gateway Configuration
# Options: 'mock' (zero-cost sandbox) or 'razorpay'
PAYMENT_PROVIDER=mock
PAYMENT_SECRET=euphoria-payment-secret-salt-2026

# Optional: Razorpay credentials (only if PAYMENT_PROVIDER=razorpay)
# RAZORPAY_KEY_ID=rzp_test_xxxxxxx
# RAZORPAY_KEY_SECRET=xxxxxxxxx
# RAZORPAY_WEBHOOK_SECRET=xxxxxxxxx

# 4. App Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
