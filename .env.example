# ==============================================================================
# EUPHORIA 2026 (KARE) - ENVIRONMENT CONFIGURATION
# ==============================================================================

# 1. Supabase Project Credentials (from your Supabase Dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key-here

# 2. Cryptographic QR Pass Signing Secret
# (Generate a random 32+ character string for production)
QR_SIGNING_SECRET=euphoria-kare-qr-signing-secret-2026-super-secure-token

# 3. Easebuzz Payment Gateway Configuration (Official College Payment Gateway)
# Set PAYMENT_PROVIDER to 'easebuzz' (production/test gateway) or 'mock' (local sandbox)
PAYMENT_PROVIDER=easebuzz

# Easebuzz Merchant Credentials (from Easebuzz Merchant Dashboard)
EASEBUZZ_KEY=your_easebuzz_merchant_key
EASEBUZZ_SALT=your_easebuzz_merchant_salt
EASEBUZZ_ENV=test # 'test' for sandbox, 'prod' for live
EASEBUZZ_SUB_MERCHANT_ID= # Optional sub-merchant ID

# Public Easebuzz Variables for Frontend Checkout SDK
NEXT_PUBLIC_EASEBUZZ_KEY=your_easebuzz_merchant_key
NEXT_PUBLIC_EASEBUZZ_ENV=test

# 4. App Base URL (used for callback & SURL/FURL redirects)
# In development: http://localhost:3000
# In production: https://euphoria.kalasalingam.ac.in
NEXT_PUBLIC_BASE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=https://euphoria.kalasalingam.ac.in

